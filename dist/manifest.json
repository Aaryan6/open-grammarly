{
  "manifest_version": 3,
  "name": "Open Grammarly",
  "version": "1.0.0",
  "description": "AI Writing Assistant using OpenRouter",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Grammarly"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-oP_ZkOoP.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/*",
        "assets/storage-BDjIbO7L.js",
        "assets/index.ts-B4PTI_k3.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
